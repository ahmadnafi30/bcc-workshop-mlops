# Copy this file to .env for local development.

AIRFLOW_UID=50000
AIRFLOW_HOME=.airflow
AIRFLOW__CORE__DAGS_FOLDER=./dags
AIRFLOW_PORT=8080

MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=taxi-demand-forecasting
MLFLOW_REGISTERED_MODEL_NAME=taxi-demand-forecasting-model
MLFLOW_PORT=5000

MODEL_ALIAS=champion
API_HOST=127.0.0.1
API_PORT=8000
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

RETRAIN_MAE_MULTIPLIER=1.25
RETRAIN_MIN_SAMPLES=100
RETRAIN_RECENT_LIMIT=500

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
